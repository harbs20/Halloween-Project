{
  "configurations": [
    {
      "name": "Arduino Uno (macOS)",
      "compilerPath": "${env:HOME}/Library/Arduino15/packages/arduino/tools/avr-gcc/7.3.0-atmel3.6.1-arduino7/bin/avr-g++",
      "compilerArgs": ["-mmcu=atmega328p"],
      "includePath": [
        "${workspaceFolder}/main/**",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.7/cores/arduino",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.7/variants/standard",
        "${env:HOME}/Library/Arduino15/libraries/Servo/src",
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.7/libraries/Wire/src",
        "${env:HOME}/Documents/Arduino/libraries/Adafruit_NeoPixel",
        "${env:HOME}/Documents/Arduino/libraries/LiquidCrystal_I2C"
      ],
      "forcedInclude": [
        "${env:HOME}/Library/Arduino15/packages/arduino/hardware/avr/1.8.7/cores/arduino/Arduino.h"
      ],
      "defines": ["ARDUINO=10607", "ARDUINO_AVR_UNO", "ARDUINO_ARCH_AVR", "F_CPU=16000000L"],
      "cStandard": "gnu11",
      "cppStandard": "gnu++11"
    }
  ],
  "version": 4
}
